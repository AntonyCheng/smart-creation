# MCP_TRANSPORT/MCP_HOST below are for running this server directly (outside
# Docker). The Docker Compose deployment ignores these two if set here: its
# Dockerfile fixes MCP_TRANSPORT=streamable-http and MCP_HOST=0.0.0.0 so the
# container is reachable through its published port; leave them out of this
# file entirely for a Docker deployment rather than copying them as-is,
# since 127.0.0.1 would make the container unreachable from the host.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=7010
MCP_API_KEY=replace-with-a-long-random-secret
MCP_PUBLIC_BASE_URL=http://127.0.0.1:7010
ARTIFACT_TTL_MINUTES=15
API_TIMEOUT_SECONDS=30

PPTMASTER_API_URL=http://127.0.0.1:8080
PPTMASTER_USERNAME=mcp-service
PPTMASTER_PASSWORD=replace-with-the-service-account-password
PPTMASTER_SESSION_COOKIE_NAME=pm_session
