# Copy this file to docker/.env. Do not commit docker/.env.
POSTGRES_DB=pptmaster
POSTGRES_USER=pptmaster
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Initial administrator. These are consumed only when the account does not exist.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=1qaz@WSX

APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8080

# Leave blank to resolve from the directory containing compose.yml. Set an
# absolute path only when the projects directory is intentionally external.
PPTMASTER_HOST_PROJECTS_ROOT=
PPTMASTER_DOCKER_SOCKET=/var/run/docker.sock
# Run short-lived OpenCode workers as the UID/GID that owns the bind-mounted
# project directory. Docker Desktop for this Windows workspace uses 10001:10001.
# On Linux, set these values to the Docker host user's `id -u` and `id -g`.
PPTMASTER_WORKER_UID=10001
PPTMASTER_WORKER_GID=10001

# Models are configured and verified by the super administrator in the platform.
# Leave blank to use docker/opencode next to compose.yml. Set an absolute path
# only when the OpenCode configuration is intentionally external.
PPTMASTER_HOST_OPENCODE_CONFIG_ROOT=
# Stop an OpenCode invocation after this many seconds without any JSONL output.
PPTMASTER_OPENCODE_IDLE_TIMEOUT_SECONDS=600
# Required before creating providers through the administrator interface. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PPTMASTER_CONFIG_ENCRYPTION_KEY=

# Use a domain name here in production to enable Caddy-managed HTTPS.
PPTMASTER_SITE_ADDRESS=:80
PPTMASTER_HTTP_PORT=8080
PPTMASTER_HTTPS_PORT=8443
# Windows commonly reserves the 6880-7990 range, so 8010 is the default.
PPTMASTER_MCP_PORT=8010
# Debian package mirror used when building the restricted job worker.
PPTMASTER_APT_MIRROR=https://mirrors.aliyun.com/debian
# Python package mirror used when building the restricted job worker.
PPTMASTER_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
