{
  "schema_version": 1,
  "skill_id": "gongwen",
  "display_name": "公文写作",
  "description": "按 GB/T 9704—2012 体例生成通知、请示、报告、纪要等公文 DOCX，附审核单与排版预览",
  "icon": "document",
  "enabled": true,
  "workspace": {
    "init": {
      "mode": "command"
    },
    "continue_seed_dir": "gongwen-project",
    "fresh_root_suffix": null,
    "authoring_root": {
      "marker_dir": "exports"
    },
    "progress_dirs": ["drafts", "exports", "preview", "validation"]
  },
  "agent": {
    "entry_doc": "skills/gongwen/SKILL.md",
    "prompt_strategy": "gongwen_quick",
    "runtime_mode": "quick",
    "repo_conventions_doc": "AGENTS.md",
    "env": {
      "GONGWEN_RUNTIME_CONFIG": "{workspace}/gongwen-runtime.json"
    }
  },
  "artifacts": [
    {
      "kind": "docx",
      "glob": "exports/**/*.docx",
      "content_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    },
    {
      "kind": "pdf",
      "glob": "exports/*.pdf",
      "content_type": "application/pdf"
    },
    {
      "kind": "png",
      "glob": "preview/*.png",
      "content_type": "image/png"
    }
  ],
  "primary_artifact_kind": "docx",
  "validation_adapter": "gongwen_docx",
  "validation": {
    "min_chars": 200
  },
  "features": {
    "templates": false,
    "page_refinement": false,
    "document_refinement": true,
    "editor": false,
    "materials_upload": true,
    "resume": true
  },
  "frontend": {
    "hero_title": "把一份要求，变成一份规范的公文",
    "hero_subtitle": "按文种与体例组织内容，生成标准格式的 Word 文档与排版预览。",
    "composer_placeholder": "描述你要写的公文，例如：起草一份关于 2026 年安全生产检查情况的通报……",
    "create_button_label": "写公文",
    "projects_nav_label": "我的公文",
    "quick_starts": ["工作通知", "情况报告", "会议纪要"],
    "stages": [
      { "id": "requirements", "label": "需求梳理", "description": "确认文种与要求" },
      { "id": "outline", "label": "提纲设计", "description": "组织公文结构" },
      { "id": "generating", "label": "生成公文", "description": "实时生成任务" },
      { "id": "preview", "label": "预览下载", "description": "查看与下载文档" }
    ],
    "modes": [
      {
        "id": "draft",
        "label": "公文起草",
        "description": "给出主题与要求，AI 按文种起草完整公文",
        "stages": [
          { "id": "requirements", "label": "需求梳理", "description": "确认文种与要求" },
          { "id": "outline", "label": "提纲设计", "description": "组织公文结构" },
          { "id": "generating", "label": "生成公文", "description": "实时生成任务" },
          { "id": "preview", "label": "预览下载", "description": "查看与下载文档" }
        ],
        "fields": [
          { "name": "topic", "label": "公文主题", "type": "text", "required": true, "max_length": 160, "wide": true },
          { "name": "doc_type", "label": "文种", "type": "select", "options": ["通知", "通报", "请示", "报告", "批复", "函", "纪要", "意见", "决定", "决议", "命令（令）", "公报", "公告", "通告", "议案"], "default": "通知" },
          { "name": "issuer", "label": "发文机关", "type": "text", "max_length": 160, "placeholder": "留空则在正文中占位" },
          { "name": "recipient", "label": "主送机关", "type": "text", "max_length": 300 },
          { "name": "word_range", "label": "字数范围", "type": "text", "max_length": 60, "placeholder": "如 800-1200" },
          { "name": "draft_depth", "label": "起草深度", "type": "select", "options": ["精简", "标准", "详尽"], "default": "标准" },
          { "name": "style", "label": "语言风格", "type": "text", "max_length": 160, "default": "规范、庄重、简明" },
          { "name": "objective", "label": "核心目标与要点", "type": "textarea", "max_length": 2000, "wide": true }
        ]
      },
      {
        "id": "typeset",
        "label": "公文排版",
        "description": "粘贴或上传已有内容，按 GB/T 9704 排出规范版式，正文逐字保留",
        "composer_placeholder": "描述你要排版的公文，例如：排版一份 2026 年安全生产检查情况通报，正文已拟好……",
        "stages": [
          { "id": "content", "label": "内容录入", "description": "粘贴或上传公文内容" },
          { "id": "format", "label": "版式要素", "description": "确认红头与版记要素" },
          { "id": "generating", "label": "生成公文", "description": "实时生成任务" },
          { "id": "preview", "label": "预览下载", "description": "查看与下载文档" }
        ],
        "fields": [
          { "name": "title", "label": "公文标题", "type": "text", "max_length": 160, "wide": true, "placeholder": "留空则从内容中识别" },
          { "name": "doc_type", "label": "文种", "type": "select", "options": ["通知", "通报", "请示", "报告", "批复", "函", "纪要", "意见", "决定", "决议", "命令（令）", "公报", "公告", "通告", "议案"], "default": "通知" },
          { "name": "issuer_mark", "label": "发文机关标志（红头）", "type": "text", "max_length": 160, "placeholder": "如 XX单位办公室文件" },
          { "name": "document_number", "label": "发文字号", "type": "text", "max_length": 120, "placeholder": "如 X政发〔2026〕12号" },
          { "name": "recipient", "label": "主送机关", "type": "text", "max_length": 300, "wide": true },
          { "name": "date", "label": "成文日期", "type": "text", "max_length": 60, "placeholder": "如 2026年9月1日，未知则占位" },
          { "name": "seal_requirement", "label": "印章要求", "type": "select", "options": ["不需要印章", "需要预留盖章位置"], "default": "不需要印章" },
          { "name": "signatory", "label": "签发人（上行文）", "type": "text", "max_length": 60 },
          { "name": "copy_to", "label": "抄送机关", "type": "text", "max_length": 300, "wide": true },
          { "name": "printing_authority", "label": "印发机关", "type": "text", "max_length": 160 },
          { "name": "print_date", "label": "印发日期", "type": "text", "max_length": 60 }
        ]
      }
    ],
    "refinement": {
      "scope": "document",
      "assistant_name": "AI 公文助手",
      "scope_label": "全文",
      "context_hint": "只会修改当前这份公文，未提及的内容保持不变。",
      "empty_hint": "告诉我想如何修改这份公文…"
    },
    "outline": {
      "item_label": "部分",
      "generator_prompt_key": "gongwen",
      "fields": [
        { "name": "title", "label": "部分标题", "required": true, "max_length": 160 },
        { "name": "purpose", "label": "本部分作用", "required": false, "max_length": 500 },
        { "name": "content", "label": "内容要点", "required": false, "max_length": 4000 },
        { "name": "kind", "label": "体例要素", "required": false, "max_length": 64, "default": "正文" },
        { "name": "notes", "label": "口径备注", "required": false, "max_length": 2000 }
      ],
      "first_item_is_title_page": true
    },
    "preview_kinds": ["png"]
  }
}
